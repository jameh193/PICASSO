rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // تنظیمات و خدمات: همه می‌خوانند، فقط مدیر می‌نویسد
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ساعت‌های اشغال‌شده (بدون نام و شماره)؛ ساخت فقط وقتی که سند وجود ندارد = جلوگیری از رزرو همزمان
    match /busy/{slot} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['date','t','bid'])
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bid)).data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn()
        && get(/databases/$(database)/documents/bookings/$(resource.data.bid)).data.uid == request.auth.uid);
    }

    // نوبت‌ها: مدیر همه را می‌بیند، مشتری فقط نوبت‌های خودش را
    match /bookings/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.note is string && request.resource.data.note.size() <= 300);
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (request.resource.data.status == 'cancelled'
            || (resource.data.status == 'proposed' && request.resource.data.status in ['confirmed','declined'])));
    }
  }
}
